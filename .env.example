# Copy to `.env` for local development (never commit the real .env).

# Required for image generation. Read from the environment / Fly.io secrets.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown).
# OPENAI_BASE_URL=https://api.openai.com
# IMAGE_MODEL=gpt-image-2
# REQUEST_TIMEOUT_SECONDS=180
# HOST=0.0.0.0
# PORT=8080

# Optional: lock the MCP transport to specific Host/Origin headers.
# Leave empty to accept any host (needed for the varying *.fly.dev hostname).
# MCP_ALLOWED_HOSTS=your-app.fly.dev
# MCP_ALLOWED_ORIGINS=https://your-app.fly.dev

# Optional: base URL used to build image links returned by the tool.
# Leave empty to auto-derive from the request (X-Forwarded-Proto + Host),
# which works on both localhost and *.fly.dev. Set to override.
# PUBLIC_BASE_URL=https://your-app.fly.dev

# Optional: where generated images are stored, and how long they live.
# IMAGE_STORAGE_DIR=/tmp/claude-mcp-images
# IMAGE_RETENTION_MINUTES=60
